# Base image
FROM ubuntu:latest

# Set default environment variables for FTP and backup directory
ENV BACKUP_DIR="/data/backup" \
    FTP_HOST="ftp.example.com" \
    FTP_USER="ftpuser" \
    FTP_PASS="ftppassword" \
    FTP_DIR="/" \
    BACKUP_TIME="02:00"

# Install required packages
RUN apt-get update && \
    apt-get install -y curl zip cron && \
    rm -rf /var/lib/apt/lists/*

# Create the backup script
RUN echo '#!/bin/sh\n' \
    'BACKUP_NAME="backup_$(date +%Y%m%d_%H%M%S).zip"\n' \
    'BACKUP_PATH="/tmp/$BACKUP_NAME"\n' \
    'echo "Creating backup of $BACKUP_DIR..."\n' \
    'zip -r "$BACKUP_PATH" "$BACKUP_DIR"\n' \
    'if [ $? -eq 0 ]; then\n' \
    '    echo "Backup created successfully: $BACKUP_PATH"\n' \
    'else\n' \
    '    echo "Error creating backup"\n' \
    '    exit 1\n' \
    'fi\n' \
    'echo "Uploading $BACKUP_NAME to FTP server $FTP_HOST..."\n' \
    'curl -T "$BACKUP_PATH" -u "$FTP_USER:$FTP_PASS" "ftp://$FTP_HOST$FTP_DIR/$BACKUP_NAME"\n' \
    'if [ $? -eq 0 ]; then\n' \
    '    echo "Backup uploaded successfully to FTP server"\n' \
    'else\n' \
    '    echo "Error uploading backup to FTP server"\n' \
    '    exit 1\n' \
    'fi\n' \
    'rm "$BACKUP_PATH"\n' \
    'echo "Backup and upload process completed."\n' \
    > /usr/local/bin/backup_and_upload.sh

# Make the backup script executable
RUN chmod +x /usr/local/bin/backup_and_upload.sh

RUN echo '#!/bin/sh\n' \
    'echo "Configuring backup cron job at $BACKUP_TIME..."\n' \
    'HOUR=$(echo $BACKUP_TIME | cut -d: -f1)\n' \
    'MINUTE=$(echo $BACKUP_TIME | cut -d: -f2)\n' \
    'echo "$MINUTE $HOUR * * * root /usr/local/bin/backup_and_upload.sh" > /etc/cron.d/backup_cron\n' \
    'chmod 0644 /etc/cron.d/backup_cron\n' \
    'crontab /etc/cron.d/backup_cron\n' \
    'echo "Starting cron..." \n' \
    'cron -f\n' \
    > /usr/local/bin/start_cron.sh

# Make the cron job script executable
RUN chmod +x /usr/local/bin/start_cron.sh

# Set the entrypoint to start cron
ENTRYPOINT ["/usr/local/bin/start_cron.sh"]
